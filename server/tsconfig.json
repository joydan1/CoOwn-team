{
  "compilerOptions": {
    "module": "commonjs",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
     "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "node",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "lib": ["es2021"],
  "include": ["src/**/*"] ,
  "exclude": ["node_modules", "dist"]
}