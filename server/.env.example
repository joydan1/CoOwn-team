# CoOwn Backend — Environment Variables
# Copy to .env in the server directory and fill in your values

# ── Server Configuration ──
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ──
PG_USERNAME=your_db_user
PG_PASSWORD=your_db_password
PG_PORT=5432
PG_DATABASE=your_database_name
HOST=your_database_host

# ── JWT Configuration ──
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ISSUER=coown

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
callbackURL=http://localhost:5000/auth/google/callback

# ── Interswitch BVN Verification ──
IT_AUTH_URL=https://qa.interswitchng.com/passport/oauth/token
IT_BASE_URL=https://api-marketplace-routing.k8.isw.la
IT_CLIENT_ID=your_interswitch_client_id
IT_SECRET_KEY=your_interswitch_secret_key

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:3000
