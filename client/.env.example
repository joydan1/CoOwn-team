# Example environment variables for different environments
# Copy this file to .env.local (local), .env.staging, or .env.production as needed

# ── LOCAL DEVELOPMENT ──
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── STAGING ──
# NEXT_PUBLIC_API_URL=https://staging-api.coown.com/api

# ── PRODUCTION ──
# NEXT_PUBLIC_API_URL=https://api.coown.com/api

# Alternative (use existing backend)
# NEXT_PUBLIC_API_URL=https://coown-team.onrender.com/api
