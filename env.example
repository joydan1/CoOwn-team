# ── CoOwn AI/ML Service — Environment Variables ──────────────────────────────
#
# Copy this to .env and fill in values before running the server.
# NEVER commit the real .env file to Git.

# API key that the backend must send in every request header (X-API-Key)
# Change this to something long and random in production.
# Example: openssl rand -hex 32
COOWN_API_KEY=coown-dev-key-change-in-prod

# Max requests per minute per IP address
RATE_LIMIT_RPM=60

# Comma-separated list of allowed frontend origins for CORS
# Use * during development. In production set your actual domain.
# Example: https://coown.app,https://staging.coown.app
ALLOWED_ORIGINS=*
